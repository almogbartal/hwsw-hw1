// Ablation results -- generated from perf stat output (`./measure.sh --stats <N>`).
// Speedup is wall-time ratio vs opt_0 (baseline). Instructions are in billions.
//
// Cell highlighting (per row, per N):
//   green  = best
//   yellow = second best
//   red    = worst
// Direction depends on the metric (lower-is-better for misses/instructions/time;
// higher-is-better for IPC/speedup).

#set page(width: auto, height: auto, margin: 1cm)
#set text(font: "New Computer Modern", size: 9pt)

// Color helpers for cell backgrounds.
#let G(body) = table.cell(fill: rgb("#c8e6c9"), body)  // best
#let Y(body) = table.cell(fill: rgb("#fff9c4"), body)  // second best
#let R(body) = table.cell(fill: rgb("#ffcdd2"), body)  // worst

#let opt-cols = 10

#let header = (
  [*Metric*], [opt_0], [opt_1], [opt_1_2], [opt_3],
  [opt_4], [opt_5], [opt_6], [opt_7], [opt_1_2_3],
)

== N = 500

